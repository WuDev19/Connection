<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ui.view.fragment.FragmentTakePhoto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/secondary"
        android:orientation="vertical"
        android:clipToPadding="false"
        android:clipChildren="false">

        <androidx.cardview.widget.CardView
            android:id="@+id/cardview"
            android:layout_width="match_parent"
            android:layout_height="380dp"
            android:layout_marginTop="20dp"
            android:elevation="20dp"
            android:translationZ="5dp"
            app:cardCornerRadius="44dp"
            app:cardPreventCornerOverlap="false">

            <androidx.camera.view.PreviewView
                android:id="@+id/img_take_photo"
                android:layout_width="match_parent"
                android:layout_height="380dp"
                app:scaleType="fillCenter"
                android:background="@color/white"/>

            <com.example.connection.ui.view.widget.ZoomableMediaLayout
                android:id="@+id/photo_preview_zoom"
                android:layout_width="match_parent"
                android:layout_height="380dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/img_picture_from_gallery"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    tools:ignore="contentDescription" />

            </com.example.connection.ui.view.widget.ZoomableMediaLayout>

            <androidx.media3.ui.PlayerView
                android:id="@+id/player_view_video"
                android:layout_width="match_parent"
                android:layout_height="380dp"
                android:visibility="gone"
                app:resize_mode="zoom"
                app:shutter_background_color="@android:color/transparent"
                app:surface_type="texture_view"
                app:use_controller="false" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="12dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:boxBackgroundMode="none"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edt_status"
                            android:layout_width="200dp"
                            android:layout_height="wrap_content"
                            android:hint="@string/status"
                            android:maxLength="30"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp"
                            android:background="@drawable/border_status"
                            android:backgroundTint="#803C3C3C"
                            android:textColor="@color/white"
                            android:textColorHint="#CCFFFFFF"
                            android:textStyle="bold"
                            android:textSize="13sp"
                            android:visibility="gone" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <ImageView
                        android:id="@+id/img_music"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/border_view"
                        android:backgroundTint="#80000000"
                        android:padding="6dp"
                        android:contentDescription="music"
                        android:scaleType="centerInside"
                        android:src="@drawable/icon_music"
                        app:tint="@color/white"
                        android:visibility="gone"
                        tools:ignore="HardcodedText" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tv_music_name"
                    android:layout_width="160dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/border_view"
                    android:backgroundTint="#80000000"
                    android:ellipsize="marquee"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:scrollHorizontally="true"
                    android:singleLine="true"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_singer_take_photo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:textColor="#EEFFFFFF"
                    android:textSize="11sp"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Floating Effect Button on camera viewfinder -->
            <ImageButton
                android:id="@+id/btn_effects"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_btn_effect_floating"
                android:contentDescription="Hiệu ứng camera"
                android:padding="9dp"
                android:scaleType="centerInside"
                android:src="@drawable/icon_camera_effects"
                app:tint="@color/white"
                android:elevation="6dp" />

            <FrameLayout
                android:id="@+id/frame_slider"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/border_avatar"
                android:layout_gravity="center_horizontal"
                android:backgroundTint="@color/white"
                android:layout_marginTop="5dp">

                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_zoom"
                    android:layout_width="300dp"
                    android:layout_height="wrap_content"
                    app:trackHeight="6dp"
                    app:thumbHeight="20dp"
                    app:thumbWidth="20dp"
                    android:layout_gravity="center"
                    app:labelBehavior="gone"
                    app:haloRadius="0dp"
                    android:background="@null"
                    app:thumbColor="@color/background"
                    app:trackColor="@color/secondary"/>

            </FrameLayout>

        </androidx.cardview.widget.CardView>

        <include
            android:id="@+id/camera_effect_controls"
            layout="@layout/camera_effect_controls" />

        <!-- 3 CỘT ĐỐI XỨNG TUYỆT ĐỐI - NÚT CHỤP VÀ NÚT TICK XANH LUÔN CHÍNH GIỮA MÀN HÌNH -->
        <LinearLayout
            android:id="@+id/layout_camera_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- CỘT 1 (Trái): Gallery hoặc Cancel -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_gravity="center">

                <ImageButton
                    android:id="@+id/btn_gallery"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_gravity="center"
                    android:background="@null"
                    android:contentDescription="@string/button_image"
                    android:scaleType="centerCrop"
                    android:src="@drawable/icon_gallery" />

                <ImageButton
                    android:id="@+id/button_cancel"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_gravity="center"
                    android:background="@null"
                    android:contentDescription="@string/button_cancel"
                    android:scaleType="centerCrop"
                    android:src="@drawable/icon_cancel"
                    android:visibility="gone"
                    tools:ignore="contentDescription" />

            </FrameLayout>

            <!-- CỘT 2 (Giữa): Chụp ảnh & Quay video hoặc Hoàn tất (LUÔN CHÍNH GIỮA 100%) -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:layout_gravity="center">

                <!-- Cụm Chụp / Quay có 2 chấm swipe cách đỉnh nút chụp -->
                <LinearLayout
                    android:id="@+id/frame_photo_video"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/linear_photo_video"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/view_swipe1"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/button_corner" />

                        <View
                            android:id="@+id/view_swipe2"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/button_corner" />

                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <ImageButton
                            android:id="@+id/button_take_photo"
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:layout_gravity="center"
                            android:background="@null"
                            android:contentDescription="@string/button_success"
                            android:scaleType="centerCrop"
                            android:src="@drawable/icon_take_photo1"
                            android:visibility="visible" />

                        <ImageButton
                            android:id="@+id/button_start_video"
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:layout_gravity="center"
                            android:background="@null"
                            android:contentDescription="@string/button_success"
                            android:scaleType="centerCrop"
                            android:src="@drawable/icon_video"
                            android:visibility="gone" />

                        <ImageButton
                            android:id="@+id/button_red_dot"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_gravity="center"
                            android:background="@null"
                            android:contentDescription="@string/button_success"
                            android:scaleType="centerCrop"
                            android:src="@drawable/icon_red_dot"
                            android:visibility="gone" />

                        <ProgressBar
                            android:id="@+id/progress_bar9"
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:layout_gravity="center"
                            android:visibility="gone"
                            android:indeterminateOnly="false"
                            android:progressDrawable="@drawable/custom_progress_video"/>

                    </FrameLayout>

                </LinearLayout>

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/button_success"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    app:lottie_rawRes="@raw/success"
                    app:lottie_autoPlay="true"
                    app:lottie_repeatCount="0"/>

            </FrameLayout>

            <!-- CỘT 3 (Phải): Rotate hoặc Download -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_gravity="center">

                <ImageButton
                    android:id="@+id/button_rotate"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_gravity="center"
                    android:background="@null"
                    android:contentDescription="@string/button_rotate"
                    android:scaleType="centerCrop"
                    android:src="@drawable/icon_rotate" />

                <ImageButton
                    android:id="@+id/button_download"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:background="@null"
                    android:contentDescription="@string/button_rotate"
                    android:scaleType="centerCrop"
                    android:src="@drawable/icon_download"
                    android:visibility="gone" />

            </FrameLayout>

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view_choose_to_post"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="14dp"
            android:visibility="gone"
            android:clipToPadding="false"
            android:clipChildren="false"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_number_post"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/border_view"
                android:backgroundTint="#FFEB3B"
                android:padding="6dp"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/history"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:id="@+id/card_view_slider"
            android:layout_width="28dp"
            android:layout_height="28dp"
            app:cardCornerRadius="10dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="16dp"
            android:visibility="visible"
            android:backgroundTint="@color/secondary">

            <com.denzcoskun.imageslider.ImageSlider
                android:id="@+id/unseen_image_slider"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:iss_no_dots="true"
                app:iss_corner_radius="10"
                app:iss_auto_cycle="true" />

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
