<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/frame_recent_chat"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.view.activity.chat.RecentChatActivity"
    android:fitsSystemWindows="true"
    android:background="@color/secondary">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view_recent_chat"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="115dp"
        android:paddingTop="30dp"
        android:background="@color/secondary"/>

    <RelativeLayout
        android:id="@+id/relative_recent_chat"
        android:layout_width="match_parent"
        android:layout_height="145dp"
        android:background="@drawable/custom_chat_title_layout">

        <ImageView
            android:id="@+id/img_back_recent_chat"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/icon_back"
            android:layout_margin="5dp"/>

        <TextView
            android:id="@+id/chat_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chat"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_toEndOf="@+id/img_back_recent_chat"
            android:padding="6dp"
            android:layout_marginTop="5dp"
            android:layout_marginStart="5dp"
            android:textColor="@color/black"
            android:layout_toStartOf="@id/tv_random_chat"/>

        <TextView
            android:id="@+id/tv_random_chat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/random"
            android:background="@drawable/border_view"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:padding="5dp"
            android:backgroundTint="@color/white"
            android:textColor="@color/black"
            android:layout_alignParentTop="true"
            android:layout_toStartOf="@+id/tv_create_group"/>

        <TextView
            android:id="@+id/tv_create_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/create_group"
            android:layout_alignParentEnd="true"
            android:background="@drawable/border_view"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:padding="5dp"
            android:backgroundTint="@color/white"
            android:textColor="@color/black"
            android:layout_alignParentTop="true" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/txt_layout_search_chat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/chat_title"
            android:layout_centerHorizontal="true"
            app:startIconDrawable="@drawable/icon_search"
            app:endIconMode="clear_text"
            app:boxCornerRadiusTopStart="30dp"
            app:boxCornerRadiusBottomEnd="30dp"
            app:boxCornerRadiusBottomStart="30dp"
            app:boxCornerRadiusTopEnd="30dp"
            app:boxStrokeWidth="0dp"
            app:boxStrokeColor="@color/white"
            app:boxBackgroundColor="#ECF1E7"
            app:hintTextColor="@color/black">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edt_search_chatroom"
                android:layout_width="270dp"
                android:layout_height="wrap_content"
                android:hint="@string/find_chat"
                android:paddingStart="40dp"
                tools:ignore="RtlSymmetry"
                android:imeOptions="actionSearch"
                android:inputType="text"/>

        </com.google.android.material.textfield.TextInputLayout>

    </RelativeLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view_search_chat"
        android:layout_width="270dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="125dp"
        android:background="@drawable/border_view"
        android:backgroundTint="#d8ffb1"
        android:padding="10dp"
        android:visibility="gone"/>

</FrameLayout>