<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".view.fragment.FragmentOptionsPost"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/relative_delete_post"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:ignore="UseCompoundDrawables">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_delete"
            android:layout_gravity="center_vertical"
            tools:ignore="contentDescription"
            android:layout_toStartOf="@+id/tv_delete_post"
            android:layout_centerVertical="true"/>

        <TextView
            android:id="@+id/tv_delete_post"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/delete_post"
            android:textStyle="bold"
            android:textColor="#F44336"
            android:padding="10dp"
            android:layout_centerHorizontal="true"
            android:layout_alignParentTop="true"
            tools:ignore="RelativeOverlap" />

    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/black"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"/>

    <RelativeLayout
        android:id="@+id/relative_download_post"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/icon_download"
            android:layout_gravity="center_vertical"
            tools:ignore="contentDescription"
            android:layout_toStartOf="@+id/tv_download_post"
            android:layout_centerVertical="true"/>

        <TextView
            android:id="@+id/tv_download_post"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/download"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:padding="10dp"
            android:layout_centerHorizontal="true"
            android:layout_alignParentTop="true"
            tools:ignore="RelativeOverlap" />

    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/black"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"/>

    <RelativeLayout
        android:id="@+id/relative_share_post"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:layout_width="23dp"
            android:layout_height="23dp"
            android:src="@drawable/icon_share"
            android:layout_gravity="center_vertical"
            tools:ignore="contentDescription"
            android:layout_toStartOf="@+id/tv_share_post"
            android:layout_centerVertical="true"/>

        <TextView
            android:id="@+id/tv_share_post"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/share"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:padding="10dp"
            android:layout_centerHorizontal="true"
            android:layout_alignParentTop="true"
            tools:ignore="RelativeOverlap" />

    </RelativeLayout>

</LinearLayout>