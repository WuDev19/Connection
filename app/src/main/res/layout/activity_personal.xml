<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/secondary"
    android:id="@+id/personal_activity"
    android:fitsSystemWindows="true"
    tools:context=".ui.view.activity.PersonalActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/back_personal"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/icon_next_right"
            android:contentDescription="@string/phone"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"/>

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/img_avatar"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="100dp"
            android:scaleType="centerCrop"
            android:src="@drawable/icon_avatar" />

        <TextView
            android:id="@+id/tv_username"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/img_avatar"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="10dp"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/bt_change_info"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tv_username"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="10dp"
            android:background="@drawable/button_corner"
            android:text="@string/change_info"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:backgroundTint="@null" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_general"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/bt_change_info"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:drawableStart="@drawable/icon_personal"
            android:drawablePadding="10dp"
            android:text="@string/general"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold" />

        <RelativeLayout
            android:id="@+id/relative1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tv_general"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/button_corner"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_email_change"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:drawableStart="@drawable/icon_email_white"
                android:drawableEnd="@drawable/icon_next_white"
                android:drawablePadding="10dp"
                android:padding="10dp"
                android:text="@string/change_email"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/view1"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_below="@id/tv_email_change"
                android:background="@color/black" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_password_change"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_below="@+id/view1"
                android:drawableStart="@drawable/icon_password_white"
                android:drawableEnd="@drawable/icon_next_white"
                android:drawablePadding="10dp"
                android:padding="10dp"
                android:text="@string/change_password"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/view3"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_below="@id/tv_password_change"
                android:background="@color/black" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_guide_widget"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:drawableStart="@drawable/icon_widget"
                android:drawablePadding="10dp"
                android:padding="10dp"
                android:text="@string/open_widget"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_below="@+id/view3"
                android:drawableEnd="@drawable/icon_next_white"/>

            <View
                android:id="@+id/view4"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_below="@id/tv_guide_widget"
                android:background="@color/black" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_contact"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_below="@+id/view4"
                android:drawableStart="@drawable/icon_contact"
                android:drawableEnd="@drawable/icon_next_white"
                android:drawablePadding="10dp"
                android:padding="10dp"
                android:text="@string/lien_he"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

        </RelativeLayout>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_dangerous"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/relative1"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:drawableStart="@drawable/icon_dangerous"
            android:drawablePadding="10dp"
            android:text="@string/dangerous"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tv_dangerous"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="15dp"
            android:background="@drawable/button_corner"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_log_out"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:drawableStart="@drawable/icon_log_out"
                android:drawableEnd="@drawable/icon_next_white"
                android:drawablePadding="10dp"
                android:padding="10dp"
                android:text="@string/log_out"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/view2"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_below="@id/tv_log_out"
                android:background="@color/black" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_delete"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_below="@+id/view2"
                android:drawableStart="@drawable/icon_delete"
                android:drawableEnd="@drawable/icon_next_white"
                android:drawablePadding="10dp"
                android:padding="10dp"
                android:text="@string/delete_account"
                android:textColor="#E91E63"
                android:textSize="18sp"
                android:textStyle="bold" />

        </RelativeLayout>

    </RelativeLayout>

</androidx.core.widget.NestedScrollView>