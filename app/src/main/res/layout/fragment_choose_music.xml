<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".view.fragment.FragmentChooseMusic"
    android:background="@drawable/corner_bottom_sheet">

    <View
        android:id="@+id/view4"
        android:layout_width="40dp"
        android:layout_height="2dp"
        android:background="@color/background_personal"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"/>

    <RelativeLayout
        android:id="@+id/relative_music"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="30dp"
        android:layout_below="@+id/view4">

        <FrameLayout
            android:id="@+id/frame_music"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:boxCornerRadiusTopStart="20dp"
                app:boxCornerRadiusBottomEnd="20dp"
                app:boxCornerRadiusBottomStart="20dp"
                app:boxCornerRadiusTopEnd="20dp"
                app:boxStrokeWidth="0dp"
                app:boxStrokeColor="@color/white"
                app:boxBackgroundColor="#F6F4F4">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edt_search_music"
                    android:layout_width="250dp"
                    android:layout_height="wrap_content"
                    android:hint="@string/search_music"
                    android:paddingStart="40dp"
                    tools:ignore="RtlSymmetry"
                    android:textColorHint="@color/black"
                    android:textColor="@color/black"/>

            </com.google.android.material.textfield.TextInputLayout>

            <ImageView
                android:id="@+id/img_search_music"
                android:layout_width="30dp"
                android:layout_height="match_parent"
                android:src="@drawable/icon_search"
                android:layout_marginStart="10dp"
                android:contentDescription="@string/search"
                android:layout_gravity="center_vertical"/>

        </FrameLayout>

        <TextView
            android:id="@+id/tv_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Cancel"
            android:background="@drawable/square_button"
            android:padding="6dp"
            android:layout_marginStart="5dp"
            android:textStyle="bold"
            android:elevation="4dp"
            android:visibility="visible"
            android:layout_toEndOf="@+id/frame_music"
            android:layout_centerVertical="true"
            android:textColor="@color/black"/>

    </RelativeLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view_music_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="3dp"
        android:layout_marginStart="3dp"
        android:layout_below="@+id/relative_music"/>

</RelativeLayout>