<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/relative_chat_2_user">

    <RelativeLayout
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_below="@+id/cardview_left"
        android:layout_alignParentStart="true"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:layout_marginStart="6dp">

        <TextView
            android:id="@+id/tv_alias"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignStart="@+id/tv_message_left"
            android:layout_marginBottom="6dp"/>

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/avt_user_in_chat"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_alignParentStart="true"
            android:src="@drawable/icon_avatar"
            android:layout_centerVertical="true"
            android:layout_below="@+id/tv_alias"/>

        <TextView
            android:id="@+id/tv_message_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/custom_chat_left"
            android:padding="6dp"
            android:backgroundTint="#F1EEEE"
            android:textColor="@color/black"
            android:layout_marginStart="35dp"
            android:layout_below="@+id/tv_alias" />

        <TextView
            android:id="@+id/tv_emote_in_chat_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tv_message_left"
            android:layout_alignEnd="@+id/tv_message_left"
            android:layout_marginEnd="5dp"
            android:visibility="gone"
            android:textSize="14sp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view_emote_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignStart="@+id/tv_message_left"
            android:layout_below="@id/tv_message_left"
            android:visibility="gone" />

    </RelativeLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardview_left"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:layout_marginStart="6dp"
        android:layout_alignParentStart="true"
        app:cardCornerRadius="20dp">

        <ImageView
            android:id="@+id/img_picture_left"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/app_name"
            android:scaleType="centerCrop"/>

    </androidx.cardview.widget.CardView>

    <RelativeLayout
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_below="@+id/cardview_right"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="5dp">

        <TextView
            android:id="@+id/tv_message_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/custom_chat_right"
            android:padding="6dp"
            android:backgroundTint="#F1EEEE"
            android:layout_alignParentEnd="true"
            android:textColor="@color/black"/>

        <TextView
            android:id="@+id/tv_emote_in_chat_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tv_message_right"
            android:layout_alignEnd="@+id/tv_message_right"
            android:layout_marginEnd="5dp"
            android:visibility="gone"
            android:textSize="14sp"
            android:textDirection="rtl"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view_emote_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignEnd="@+id/tv_message_right"
            android:visibility="gone"
            android:layout_below="@+id/tv_message_right"/>

    </RelativeLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardview_right"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:layout_marginEnd="6dp"
        android:layout_alignParentEnd="true"
        app:cardCornerRadius="20dp">

        <ImageView
            android:id="@+id/img_picture_right"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/app_name"
            android:scaleType="centerCrop"/>

    </androidx.cardview.widget.CardView>

</RelativeLayout>