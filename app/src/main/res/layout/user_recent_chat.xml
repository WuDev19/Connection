<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:cardCornerRadius="15dp"
    android:layout_margin="3dp">

    <RelativeLayout
        android:id="@+id/relative_recent_chat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/border_view">

        <FrameLayout
            android:id="@+id/frame_layout_recent_chat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp">

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/img_avatar_recent_chat"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/icon_avatar"/>

            <ImageView
                android:id="@+id/img_active"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/button_corner"
                android:backgroundTint="#4CAF50"
                android:layout_gravity="end|bottom"
                android:contentDescription="@string/app_name"
                android:visibility="gone"/>

        </FrameLayout>

        <RelativeLayout
            android:layout_width="230dp"
            android:layout_height="match_parent"
            android:layout_alignBottom="@+id/frame_layout_recent_chat"
            android:layout_alignTop="@id/frame_layout_recent_chat"
            android:layout_toEndOf="@id/frame_layout_recent_chat"
            android:orientation="vertical"
            android:layout_centerVertical="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_username_recent_chat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:textColor="@color/black"/>

                <TextView
                    android:id="@+id/tv_recent_message"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"/>

            </LinearLayout>

        </RelativeLayout>

    </RelativeLayout>

    <TextView
        android:id="@+id/tv_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:layout_gravity="end|center_vertical"
        android:textColor="@color/black"/>

</androidx.cardview.widget.CardView>