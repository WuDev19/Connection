<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".view.fragment.FragmentChangePassword"
    android:orientation="vertical"
    android:background="@drawable/corner_bottom_sheet">

    <View
        android:layout_width="40dp"
        android:layout_height="2dp"
        android:background="@color/black"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"/>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="130dp"
        android:layout_marginStart="50dp"
        android:layout_marginEnd="50dp">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:boxCornerRadiusTopStart="10dp"
            app:boxCornerRadiusBottomEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusTopEnd="10dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edt_password_old"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/old_password"
                android:inputType="textPassword"
                android:textStyle="bold"
                android:drawableStart="@drawable/icon_password"
                android:drawablePadding="10dp"
                android:textColorHint="@color/black"
                android:textColor="@color/black"/>

        </com.google.android.material.textfield.TextInputLayout>

        <ImageView
            android:id="@+id/img_show_password4"
            android:layout_width="20dp"
            android:layout_height="20dp"
            tools:ignore="contentDescription"
            android:src="@drawable/icon_eye"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="8dp"/>

    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginStart="50dp"
        android:layout_marginEnd="50dp">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:boxCornerRadiusTopStart="10dp"
            app:boxCornerRadiusBottomEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusTopEnd="10dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edt_password_new"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/new_password"
                android:inputType="textPassword"
                android:textStyle="bold"
                android:drawableStart="@drawable/icon_password"
                android:drawablePadding="10dp"
                android:textColorHint="@color/black"
                android:textColor="@color/black"/>

        </com.google.android.material.textfield.TextInputLayout>

        <ImageView
            android:id="@+id/img_show_password5"
            android:layout_width="20dp"
            android:layout_height="20dp"
            tools:ignore="contentDescription"
            android:src="@drawable/icon_eye"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="8dp"/>

    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginStart="50dp"
        android:layout_marginEnd="50dp">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:boxCornerRadiusTopStart="10dp"
            app:boxCornerRadiusBottomEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusTopEnd="10dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edt_password_new_confirm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/new_password_confirm"
                android:inputType="textPassword"
                android:textStyle="bold"
                android:drawableStart="@drawable/icon_password"
                android:drawablePadding="10dp"
                android:textColorHint="@color/black"
                android:textColor="@color/black"/>

        </com.google.android.material.textfield.TextInputLayout>

        <ImageView
            android:id="@+id/img_show_password6"
            android:layout_width="20dp"
            android:layout_height="20dp"
            tools:ignore="contentDescription"
            android:src="@drawable/icon_eye"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="8dp"/>

    </FrameLayout>

    <Button
        android:id="@+id/bt_confirm_change_password"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/confirm"
        android:layout_marginTop="10dp"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/button_click_animate"
        app:backgroundTint="@null"/>

    <ProgressBar
        android:id="@+id/progress_bar5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:visibility="gone"/>

</LinearLayout>